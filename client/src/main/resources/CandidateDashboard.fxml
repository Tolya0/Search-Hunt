<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<BorderPane prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.kurilin.recruitment.client.controller.CandidateController">
    <top>
        <BorderPane prefHeight="100.0" prefWidth="1000.0" BorderPane.alignment="CENTER">
            <left>
                <VBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="10.0"
                      BorderPane.alignment="CENTER">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                    </padding>
                    <ImageView fitHeight="40.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true">
                        <Image url="@logo.png"/>
                    </ImageView>
                    <Label text="Candidate Portal">
                        <styleClass>
                            <String fx:value="title-4"/>
                        </styleClass>
                    </Label>
                </VBox>
            </left>
            <right>
                <Button mnemonicParsing="false" onAction="#handleLogout" text="Logout" BorderPane.alignment="CENTER">
                    <BorderPane.margin>
                        <Insets right="20.0"/>
                    </BorderPane.margin>
                    <styleClass>
                        <String fx:value="danger"/>
                    </styleClass>
                </Button>
            </right>
        </BorderPane>
    </top>
    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
            <Tab text="Search Vacancies">
                <BorderPane prefHeight="200.0" prefWidth="200.0">
                    <top>
                        <HBox alignment="CENTER_LEFT" spacing="15.0" BorderPane.alignment="CENTER">
                            <padding>
                                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0"/>
                            </padding>
                            <TextField fx:id="searchKeywordField" prefWidth="300.0"
                                       promptText="Keyword (e.g. Java, Manager)"/>
                            <TextField fx:id="searchSalaryField" prefWidth="200.0"
                                       promptText="Expected Salary (Min)"/>
                            <Button mnemonicParsing="false" onAction="#handleSearchVacancies" text="Search">
                                <styleClass>
                                    <String fx:value="accent"/>
                                </styleClass>
                            </Button>
                        </HBox>
                    </top>
                    <center>
                        <SplitPane dividerPositions="0.7" BorderPane.alignment="CENTER">
                            <TableView fx:id="searchTable" prefHeight="200.0" prefWidth="200.0">
                                <columns>
                                    <TableColumn fx:id="searchTitleCol" prefWidth="250.0" text="Title"/>
                                    <TableColumn fx:id="searchDeptCol" prefWidth="150.0" text="Department"/>
                                    <TableColumn fx:id="searchSalaryCol" prefWidth="150.0" text="Salary"/>
                                    <TableColumn fx:id="searchFormatCol" prefWidth="100.0" text="Format"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <styleClass>
                                    <String fx:value="striped"/>
                                </styleClass>
                            </TableView>
                            <VBox spacing="15.0">
                                <padding>
                                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                                </padding>
                                <Label text="Vacancy Details">
                                    <styleClass>
                                        <String fx:value="title-3"/>
                                    </styleClass>
                                </Label>
                                <Label style="-fx-font-weight: bold;" text="Requirements:"/>
                                <Label fx:id="detailsReqLabel" text="Select a vacancy..."
                                       wrapText="true"/>
                                <Label style="-fx-font-weight: bold;" text="Description:"/>
                                <Label fx:id="detailsDescLabel" text="Select a vacancy..."
                                       wrapText="true"/>
                                <ComboBox fx:id="sourceComboBox" prefWidth="300.0" promptText="Hear about us?"/>
                                <Button fx:id="applyButton" disable="true" mnemonicParsing="false"
                                        onAction="#handleApply" prefWidth="300.0"
                                        text="Apply for this Job">
                                    <VBox.margin>
                                        <Insets top="20.0"/>
                                    </VBox.margin>
                                    <styleClass>
                                        <String fx:value="success"/>
                                    </styleClass>
                                </Button>
                            </VBox>
                        </SplitPane>
                    </center>
                </BorderPane>
            </Tab>
            <Tab text="My Applications">
                <BorderPane prefHeight="200.0" prefWidth="200.0">
                    <center>
                        <TableView fx:id="myAppsTable" prefHeight="200.0" prefWidth="200.0"
                                   BorderPane.alignment="CENTER">
                            <columns>
                                <TableColumn fx:id="myAppTitleCol" prefWidth="200.0" text="Vacancy"/>
                                <TableColumn fx:id="myAppDeptCol" prefWidth="150.0" text="Department"/>
                                <TableColumn fx:id="myAppStatusCol" prefWidth="150.0" text="Status"/>
                                <TableColumn fx:id="myAppDateCol" prefWidth="150.0" text="Applied On"/>
                                <TableColumn fx:id="myAppOfferCol" prefWidth="250.0" text="Offer / Notes"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <BorderPane.margin>
                                <Insets bottom="10.0" left="20.0" right="20.0" top="20.0"/>
                            </BorderPane.margin>
                        </TableView>
                    </center>
                    <bottom>
                        <HBox alignment="CENTER" spacing="20.0" BorderPane.alignment="CENTER">
                            <padding>
                                <Insets bottom="20.0"/>
                            </padding>
                            <Button fx:id="acceptOfferBtn" disable="true" mnemonicParsing="false"
                                    onAction="#handleAcceptOffer" text="Accept Offer" prefWidth="200.0">
                                <styleClass>
                                    <String fx:value="success"/>
                                </styleClass>
                            </Button>
                            <Button fx:id="declineOfferBtn" disable="true" mnemonicParsing="false"
                                    onAction="#handleDeclineOffer" text="Decline Offer" prefWidth="200.0">
                                <styleClass>
                                    <String fx:value="danger"/>
                                </styleClass>
                            </Button>
                        </HBox>
                    </bottom>
                </BorderPane>
            </Tab>
            <Tab text="My Profile">
                <BorderPane prefHeight="200.0" prefWidth="200.0">
                    <center>
                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
                            <VBox alignment="CENTER" maxWidth="400.0" spacing="15.0"
                                  BorderPane.alignment="CENTER">
                                <padding>
                                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                                </padding>
                                <Label text="Edit Profile">
                                    <styleClass>
                                        <String fx:value="title-2"/>
                                    </styleClass>
                                    <VBox.margin>
                                        <Insets bottom="10.0"/>
                                    </VBox.margin>
                                </Label>
                                <TextField fx:id="profileFullNameField" promptText="Full Name"/>
                                <TextField fx:id="profileEmailField" promptText="Email"/>
                                <TextField fx:id="profilePhoneField" promptText="Phone Number"/>
                                <DatePicker fx:id="profileBirthDatePicker" prefWidth="400.0"
                                            promptText="Date of Birth"/>
                                <TextField fx:id="profileExperienceField" promptText="Experience (years)"/>
                                <TextField fx:id="profileSkillsField"
                                           promptText="Skills (comma separated)"/>
                                <TextField fx:id="profileSalaryField" promptText="Expected Salary (USD)"/>
                                <TextField fx:id="profileResumeField" promptText="Resume"/>
                                <Button mnemonicParsing="false" onAction="#handleUpdateProfile"
                                        prefWidth="400.0" text="Save Profile Changes">
                                    <styleClass>
                                        <String fx:value="success"/>
                                    </styleClass>
                                    <VBox.margin>
                                        <Insets bottom="20.0" top="10.0"/>
                                    </VBox.margin>
                                </Button>
                                <Separator prefWidth="200.0"/>
                                <Label text="Change Password">
                                    <styleClass>
                                        <String fx:value="card"/>
                                        <String fx:value="title-3"/>
                                    </styleClass>
                                </Label>
                                <PasswordField fx:id="oldPasswordField" promptText="Current Password"/>
                                <PasswordField fx:id="newPasswordField" promptText="New Password"/>
                                <Button mnemonicParsing="false" onAction="#handleChangePassword"
                                        prefWidth="400.0" text="Update Password">
                                    <styleClass>
                                        <String fx:value="accent"/>
                                    </styleClass>
                                </Button>
                            </VBox>
                        </ScrollPane>
                    </center>
                </BorderPane>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
