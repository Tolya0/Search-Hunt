<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox alignment="CENTER" prefHeight="600.0" prefWidth="800.0" spacing="20.0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.kurilin.recruitment.client.controller.RegisterCandidateController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
    </padding>
    <Label text="Candidate Registration">
        <styleClass>
            <String fx:value="title-1"/>
        </styleClass>
    </Label>

    <HBox alignment="CENTER" spacing="40.0">
        <VBox prefWidth="300.0" spacing="15.0">
            <Label text="Personal Details">
                <styleClass>
                    <String fx:value="title-4"/>
                </styleClass>
            </Label>
            <TextField fx:id="usernameField" promptText="Username"/>
            <PasswordField fx:id="passwordField" promptText="Password"/>
            <PasswordField fx:id="confirmPasswordField" promptText="Confirm Password"/>
            <TextField fx:id="fullNameField" promptText="Full Name"/>
            <TextField fx:id="emailField" promptText="Email"/>
            <TextField fx:id="phoneField" promptText="Phone Number"/>
            <DatePicker fx:id="birthDatePicker" promptText="Date of Birth" prefWidth="300.0"/>
            <ComboBox fx:id="sexComboBox" promptText="Sex" prefWidth="300.0"/>
        </VBox>

        <VBox prefWidth="300.0" spacing="15.0">
            <Label text="Professional Details">
                <styleClass>
                    <String fx:value="title-4"/>
                </styleClass>
            </Label>
            <TextField fx:id="experienceField" promptText="Experience (years, e.g. 2)"/>
            <TextField fx:id="skillsField" promptText="Skills (comma separated, e.g. Java, SQL)"/>
            <TextField fx:id="salaryField" promptText="Expected Salary (USD)"/>
            <TextField fx:id="resumeField" promptText="Resume URL (optional)"/>
        </VBox>
    </HBox>

    <Button defaultButton="true" mnemonicParsing="false" onAction="#handleRegister" prefWidth="300.0" text="Sign Up">
        <styleClass>
            <String fx:value="accent"/>
        </styleClass>
    </Button>
    <Button mnemonicParsing="false" onAction="#handleBackToLogin" text="Back to Login" styleClass="flat"/>
</VBox>
