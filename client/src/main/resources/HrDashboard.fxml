<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<BorderPane prefHeight="900.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.kurilin.recruitment.client.controller.HrController">
    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
            <Tab text="Manage Vacancies">
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                    <SplitPane dividerPositions="0.7" prefHeight="669.0" prefWidth="1000.0"
                               AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                               AnchorPane.topAnchor="0.0">
                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="160.0" prefWidth="100.0">
                            <SplitPane dividerPositions="0.6" orientation="VERTICAL" AnchorPane.bottomAnchor="0.0"
                                       AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                                       AnchorPane.topAnchor="0.0">

                                <TableView fx:id="vacanciesTable" prefHeight="667.0" prefWidth="695.0"
                                           AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                                           AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                    <columns>
                                        <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID"/>
                                        <TableColumn fx:id="titleColumn" prefWidth="200.0" text="Title"/>
                                        <TableColumn fx:id="deptColumn" prefWidth="150.0" text="Department"/>
                                        <TableColumn fx:id="salaryColumn" prefWidth="150.0" text="Salary"/>
                                        <TableColumn fx:id="statusColumn" prefWidth="120.0" text="Status"/>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                    <styleClass>
                                        <String fx:value="striped"/>
                                    </styleClass>
                                </TableView>

                                <VBox spacing="10.0">
                                    <padding>
                                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                                    </padding>
                                    <Label text="Applications for Selected Vacancy">
                                        <styleClass>
                                            <String fx:value="title-4"/>
                                        </styleClass>
                                    </Label>
                                    <TableView fx:id="applicationsTable" prefHeight="300.0" prefWidth="200.0"
                                               VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="appIdColumn" prefWidth="50.0" text="ID"/>
                                            <TableColumn fx:id="appNameColumn" prefWidth="200.0" text="Candidate Name"/>
                                            <TableColumn fx:id="appSourceColumn" prefWidth="100.0" text="Source"/>
                                            <TableColumn fx:id="appDateColumn" prefWidth="150.0" text="Date"/>
                                            <TableColumn fx:id="appStatusColumn" prefWidth="120.0" text="Status"/>
                                        </columns>
                                        <columnResizePolicy>
                                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                        </columnResizePolicy>
                                    </TableView>
                                    <HBox spacing="10.0">
                                        <Button fx:id="viewProfileButton" disable="true" text="View Profile"
                                                onAction="#handleViewProfile" styleClass="flat"/>
                                        <Button fx:id="scoreButton" disable="true" text="Calculate Score"
                                                onAction="#handleCalculateScore"/>
                                        <Button fx:id="inviteButton" disable="true" text="Invite to Interview"
                                                onAction="#handleInviteToInterview"/>
                                        <Button fx:id="offerButton" disable="true" text="Make Offer"
                                                onAction="#handleMakeOffer">
                                            <styleClass>
                                                <String fx:value="success"/>
                                            </styleClass>
                                        </Button>
                                        <Button fx:id="rejectButton" disable="true" text="Reject"
                                                onAction="#handleRejectApplication">
                                            <styleClass>
                                                <String fx:value="danger"/>
                                            </styleClass>
                                        </Button>
                                    </HBox>
                                </VBox>
                            </SplitPane>
                        </AnchorPane>
                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="160.0" prefWidth="100.0">
                            <VBox prefHeight="667.0" prefWidth="296.0" spacing="15.0" AnchorPane.bottomAnchor="15.0"
                                  AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0"
                                  AnchorPane.topAnchor="15.0">
                                <padding>
                                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                                </padding>
                                <styleClass>
                                    <String fx:value="card"/>
                                    <String fx:value="elevated-2"/>
                                </styleClass>
                                <Label text="Create New Vacancy">
                                    <VBox.margin>
                                        <Insets bottom="10.0"/>
                                    </VBox.margin>
                                    <styleClass>
                                        <String fx:value="title-3"/>
                                    </styleClass>
                                </Label>
                                <TextField fx:id="titleField" promptText="Title"/>
                                <TextField fx:id="requirementsField" promptText="Requirements"/>
                                <TextField fx:id="descriptionField" promptText="Description"/>
                                <TextField fx:id="salaryMinField" promptText="Salary From"/>
                                <TextField fx:id="salaryMaxField" promptText="Salary To"/>
                                <ComboBox fx:id="workFormatComboBox" prefWidth="150.0" promptText="Work Format"/>
                                <ComboBox fx:id="deptComboBox" prefWidth="300.0" promptText="Department"/>
                                <Button fx:id="submitButton" mnemonicParsing="false" onAction="#handleSubmitVacancy"
                                        prefHeight="26.0" prefWidth="282.0" text="Create Vacancy">
                                    <VBox.margin>
                                        <Insets top="10.0"/>
                                    </VBox.margin>
                                    <styleClass>
                                        <String fx:value="success"/>
                                    </styleClass>
                                </Button>
                                <Button fx:id="clearButton" mnemonicParsing="false" onAction="#handleClearVacancyForm"
                                        prefWidth="300.0" text="Clear Form"/>
                                <Button fx:id="closeButton" disable="true" mnemonicParsing="false"
                                        onAction="#handleCloseVacancy" prefWidth="300.0" text="Close Vacancy">
                                    <styleClass>
                                        <String fx:value="danger"/>
                                    </styleClass>
                                </Button>
                            </VBox>
                        </AnchorPane>
                    </SplitPane>
                </AnchorPane>
            </Tab>
            <Tab text="Interviews">
                <SplitPane dividerPositions="0.7">
                    <TableView fx:id="interviewsTable" prefHeight="200.0" prefWidth="200.0">
                        <columns>
                            <TableColumn fx:id="intIdColumn" prefWidth="50.0" text="ID"/>
                            <TableColumn fx:id="intCandidateColumn" prefWidth="200.0" text="Candidate"/>
                            <TableColumn fx:id="intVacancyColumn" prefWidth="200.0" text="Vacancy"/>
                            <TableColumn fx:id="intDateColumn" prefWidth="150.0" text="Date and Time"/>
                            <TableColumn fx:id="intLocationColumn" prefWidth="200.0" text="Location (Zoom/Office)"/>
                            <TableColumn fx:id="intStatusColumn" prefWidth="100.0" text="Status"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                        </padding>
                    </TableView>
                    <VBox prefWidth="300.0" spacing="15.0">
                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                        </padding>
                        <Label text="Conduct Interview">
                            <styleClass>
                                <String fx:value="title-3"/>
                            </styleClass>
                        </Label>
                        <Label text="Candidate:" style="-fx-font-weight: bold;"/>
                        <Label fx:id="evalCandidateNameLabel" text="Select an interview..."
                               wrapText="true"/>
                        <Separator/>
                        <TextField fx:id="evalScoreField" promptText="Evaluation (0 - 10)"/>
                        <TextArea fx:id="evalCommentsArea" prefHeight="100.0"
                                  promptText="Comments (Soft/Hard skills...)" wrapText="true"/>
                        <ComboBox fx:id="evalPassedCombo" prefWidth="300.0" promptText="Decision"/>

                        <Button fx:id="evalSubmitBtn" disable="true" mnemonicParsing="false"
                                onAction="#handleSubmitEvaluation" prefWidth="300.0"
                                text="Save Evaluation">
                            <styleClass>
                                <String fx:value="success"/>
                            </styleClass>
                            <VBox.margin>
                                <Insets top="10.0"/>
                            </VBox.margin>
                        </Button>
                    </VBox>
                </SplitPane>
            </Tab>
            <Tab text="Search Candidates">
                <BorderPane prefHeight="200.0" prefWidth="200.0">
                    <top>
                        <HBox alignment="CENTER_LEFT" spacing="15.0" BorderPane.alignment="CENTER">
                            <padding>
                                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0"/>
                            </padding>
                            <TextField fx:id="searchSkillsField" prefWidth="300.0"
                                       promptText="Skills (e.g., Java, SQL)"/>
                            <TextField fx:id="searchExpField" prefWidth="200.0"
                                       promptText="Min. Experience (years)"/>
                            <Button mnemonicParsing="false" onAction="#handleSearchCandidates" text="Search">
                                <styleClass>
                                    <String fx:value="accent"/>
                                </styleClass>
                            </Button>
                        </HBox>
                    </top>
                    <center>
                        <TableView fx:id="candidatesTable" prefHeight="200.0" prefWidth="200.0"
                                   BorderPane.alignment="CENTER">
                            <columns>
                                <TableColumn fx:id="candIdCol" prefWidth="50.0" text="ID"/>
                                <TableColumn fx:id="candNameCol" prefWidth="200.0" text="Full Name"/>
                                <TableColumn fx:id="candEmailCol" prefWidth="150.0" text="Email"/>
                                <TableColumn fx:id="candExpCol" prefWidth="100.0" text="Experience (years)"/>
                                <TableColumn fx:id="candSkillsCol" prefWidth="250.0" text="Skills"/>
                                <TableColumn fx:id="candSalaryCol" prefWidth="100.0" text="Salary"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <BorderPane.margin>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="10.0"/>
                            </BorderPane.margin>
                        </TableView>
                    </center>
                </BorderPane>
            </Tab>
            <Tab text="Analytics">
                <BorderPane prefHeight="200.0" prefWidth="200.0">
                    <center>
                        <HBox alignment="CENTER" spacing="40.0" BorderPane.alignment="CENTER">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                            </padding>
                            <VBox prefWidth="400.0" spacing="15.0">
                                <padding>
                                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                                </padding>
                                <styleClass>
                                    <String fx:value="card"/>
                                    <String fx:value="elevated-2"/>
                                </styleClass>
                                <Label text="General Statistics">
                                    <styleClass>
                                        <String fx:value="title-3"/>
                                    </styleClass>
                                </Label>
                                <Button mnemonicParsing="false" onAction="#handleGenerateGeneralReports"
                                        prefWidth="400.0" text="Generate Reports">
                                    <styleClass>
                                        <String fx:value="accent"/>
                                    </styleClass>
                                </Button>
                                <Button mnemonicParsing="false" onAction="#handleSaveGeneralReport" prefWidth="400.0"
                                        text="Save as .txt" styleClass="success"/>
                                <TextArea fx:id="generalReportArea" editable="false" prefHeight="400.0"
                                          wrapText="true" style="-fx-font-family: monospace;"/>
                            </VBox>
                            <VBox prefWidth="400.0" spacing="15.0">
                                <padding>
                                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                                </padding>
                                <styleClass>
                                    <String fx:value="card"/>
                                    <String fx:value="elevated-2"/>
                                </styleClass>
                                <Label text="Hiring Funnel">
                                    <styleClass>
                                        <String fx:value="title-3"/>
                                    </styleClass>
                                </Label>
                                <ComboBox fx:id="reportVacancyCombo" prefWidth="400.0"
                                          promptText="Select a vacancy..."/>
                                <Button mnemonicParsing="false" onAction="#handleGenerateFunnel" prefWidth="400.0"
                                        text="Build Funnel">
                                    <styleClass>
                                        <String fx:value="accent"/>
                                    </styleClass>
                                </Button>
                                <Button mnemonicParsing="false" onAction="#handleSaveFunnelReport" prefWidth="400.0"
                                        text="Save as .txt" styleClass="success"/>
                                <TextArea fx:id="funnelReportArea" editable="false" prefHeight="400.0"
                                          wrapText="true" style="-fx-font-family: monospace;"/>
                            </VBox>
                        </HBox>
                    </center>
                </BorderPane>
            </Tab>
        </TabPane>
    </center>
    <top>
        <BorderPane prefHeight="120.0" prefWidth="1000.0" BorderPane.alignment="CENTER">
            <left>
                <VBox prefHeight="120.0" prefWidth="138.5" spacing="10.0" BorderPane.alignment="CENTER">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                    </padding>
                    <ImageView fitHeight="50.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
                        <Image url="@logo.png"/>
                    </ImageView>
                    <Label text="HR Dashboard"/>
                </VBox>
            </left>
            <right>
                <Button mnemonicParsing="false" onAction="#handleLogout" styleClass="danger" text="Logout"
                        BorderPane.alignment="CENTER">
                    <BorderPane.margin>
                        <Insets right="20.0"/>
                    </BorderPane.margin>
                </Button>
            </right>
        </BorderPane>
    </top>
</BorderPane>
